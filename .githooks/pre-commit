#!/bin/bash
# EDS Radar — Gizli bilgi tespit pre-commit hook
# Commit öncesi API key, keystore, password gibi hassas verileri yakalar.

RED='\033[0;31m'
NC='\033[0m'

BLOCKED=0

# 1. Yasaklı dosya kontrolü
FORBIDDEN="key.properties local.properties"
FORBIDDEN_EXT=".jks .keystore"

for f in $(git diff --cached --name-only); do
    base=$(basename "$f")
    for forbidden in $FORBIDDEN; do
        if [ "$base" = "$forbidden" ]; then
            echo -e "${RED}🚫 Yasaklı dosya: $f${NC}"
            BLOCKED=1
        fi
    done
    for ext in $FORBIDDEN_EXT; do
        case "$base" in
            *"$ext") echo -e "${RED}🚫 Yasaklı dosya: $f${NC}"; BLOCKED=1 ;;
        esac
    done
done

# 2. Staged diff'teki eklenen satırları al
DIFF=$(git diff --cached -U0 --diff-filter=ACM | grep '^+' | grep -v '^+++')

if [ -n "$DIFF" ]; then
    # Google API Key
    if echo "$DIFF" | grep -q 'AIza[0-9A-Za-z_-]'; then
        echo -e "${RED}🚫 Google API Key tespit edildi${NC}"
        echo "$DIFF" | grep 'AIza' | head -3 | while read line; do echo "   $line"; done
        BLOCKED=1
    fi

    # MAPS_API_KEY ataması
    if echo "$DIFF" | grep -q 'MAPS_API_KEY'; then
        echo -e "${RED}🚫 Maps API Key ataması tespit edildi${NC}"
        echo "$DIFF" | grep 'MAPS_API_KEY' | head -3 | while read line; do echo "   $line"; done
        BLOCKED=1
    fi

    # AdMob App ID
    if echo "$DIFF" | grep -q 'ca-app-pub-'; then
        echo -e "${RED}🚫 AdMob App ID tespit edildi${NC}"
        BLOCKED=1
    fi

    # Keystore şifreleri
    if echo "$DIFF" | grep -qi 'keyPassword.*=\|storePassword.*='; then
        echo -e "${RED}🚫 Keystore şifresi tespit edildi${NC}"
        BLOCKED=1
    fi

    # Private key
    if echo "$DIFF" | grep -q 'BEGIN.*PRIVATE KEY'; then
        echo -e "${RED}🚫 Private key tespit edildi${NC}"
        BLOCKED=1
    fi
fi

if [ $BLOCKED -eq 1 ]; then
    echo ""
    echo -e "${RED}Commit engellendi. Yukarıdaki dosya/satırları düzeltin.${NC}"
    echo "  git reset HEAD <dosya>  — dosyayı staging'den çıkar"
    echo ""
    exit 1
fi

exit 0
